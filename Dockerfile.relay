# Dedicated 24/7 Frills Plus TikTok LIVE Relay (Railway / Docker)
# Runs helper/server.mjs in --relay mode with RELAY_TICKET_SECRET enforcement.

FROM node:22-slim

WORKDIR /app

# Copy root package.json (for "type": "module") and install only helper runtime deps
COPY package.json ./
COPY helper/package.json helper/package-lock.json ./helper/
RUN npm --prefix helper ci --omit=dev --ignore-scripts --no-audit --no-fund

# Copy only the runtime modules imported by helper/server.mjs
COPY helper ./helper
COPY worker ./worker
COPY scripts/lib/static.mjs ./scripts/lib/static.mjs
COPY src/js ./src/js

ENV NODE_ENV=production
ENV FRILLS_RELAY=1
ENV RELAY_BIND=0.0.0.0
ENV RELAY_TRUST_PROXY=1
ENV RELAY_ALERTS=0

USER node
EXPOSE 8765

CMD ["node", "helper/server.mjs", "--relay"]
